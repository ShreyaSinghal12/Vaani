# Set both keys on the deployed app - that is where the AI runs.
# Without them Vaani still works for testing: the rules and the trained classifier still check
# messages, the phone's browser does voice, and photos are read with Tesseract in the browser.

# Sarvam AI - speech to text and text to speech for Indian languages (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Anthropic Claude - reads screenshots and messy Hinglish messages, answers follow-up questions in dialect
ANTHROPIC_API_KEY=
# Model for reading messages and screenshots (fast, cheap)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Keep the full message text in vaani.db? Default 0 keeps only a copy with digits masked.
LOG_RAW_TEXT=0

# Model for follow-up answers in dialect (better language quality than the reading model)
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
